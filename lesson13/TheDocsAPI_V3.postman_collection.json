    {
      "name": "upload images",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "\r",
              "    const ids = pm.response.json().map(image => image.id);\r",
              "    pm.expect(ids.length).to.be.greaterThan(0);\r",
              "\r",
              "    pm.collectionVariables.set(\"imagesIds\", ids.join(\",\"));\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
